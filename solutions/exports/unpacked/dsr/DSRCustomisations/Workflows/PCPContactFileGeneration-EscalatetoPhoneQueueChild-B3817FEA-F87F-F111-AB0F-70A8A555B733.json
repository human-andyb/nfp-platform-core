                  },
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "arDSR_ProspectContacts",
                    "value": {
                      "ConstituentID": "@{outputs('contact')?['body/hit_constituentid']}",
                      "Organisation": "",
                      "FullName": "@{outputs('contact')?['body/fullname']}",
                      "Phone1": "@{replace(coalesce(outputs('contact')?['body/mobilephone'],''),' ','')}",
                      "Phone2": "@{replace(coalesce(outputs('contact')?['body/telephone2'],''),' ','')}",
                      "Phone3": "@{replace(coalesce(outputs('contact')?['body/telephone1'],''),' ','')}",
                      "Email": "@{coalesce(outputs('contact')?['body/emailaddress1'],'')}",
                      "Location": "VIC",
                      "CRMUrl": "@{variables('sCrmUrlBase')}@{outputs('contact')?['body/contactid']}"
                    }
                  }
                }
              },
              "runAfter": {
                "contact": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {
                  "Append_to_arDSR_ActiveContacts": {
                    "metadata": {
                      "operationMetadataId": "7ae72d20-a7f7-41cc-8ffc-ff5394207041"
                    },
                    "type": "AppendToArrayVariable",
                    "inputs": {
                      "name": "arDSR_ActiveContacts",
                      "value": {
                        "ConstituentID": "@{outputs('contact')?['body/hit_constituentid']}",
                        "Organisation": "",
                        "FullName": "@{outputs('contact')?['body/fullname']}",
                        "Phone1": "@{replace(coalesce(outputs('contact')?['body/mobilephone'],''),' ','')}",
                        "Phone2": "@{replace(coalesce(outputs('contact')?['body/telephone2'],''),' ','')}",
                        "Phone3": "@{replace(coalesce(outputs('contact')?['body/telephone1'],''),' ','')}",
                        "Email": "@{coalesce(outputs('contact')?['body/emailaddress1'],'')}",
                        "Location": "VIC",
                        "CRMUrl": "@{variables('sCrmUrlBase')}@{outputs('contact')?['body/contactid']}"
                      }
                    }
                  }
                }
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@outputs('contact')?['body/hit_dlfcode']",
                      "DLF__PROSPECT"
                    ]
                  }
                ]
              },
              "type": "If"
            }
